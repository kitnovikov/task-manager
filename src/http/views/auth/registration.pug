doctype html
html(lang="ru")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Регистрация
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css",
            rel="stylesheet"
        )
        style.
            body {
                min-height: 100vh;
                background:
                    radial-gradient(circle at top left, rgba(13, 110, 253, .16), transparent 34rem),
                    linear-gradient(135deg, #f8f9fa 0%, #eef2f7 100%);
            }

            .auth-card {
                border-radius: 1rem;
            }

            .brand-mark {
                width: 3rem;
                height: 3rem;
            }
    body
        main.container
            .row.min-vh-100.align-items-center.justify-content-center.py-5
                .col-12.col-sm-10.col-md-8.col-lg-5
                    .card.auth-card.border-0.shadow-lg
                        .card-body.p-4.p-md-5

                            if user
                                .text-center
                                    .brand-mark.bg-success.bg-opacity-10.text-success.rounded-circle.d-inline-flex.align-items-center.justify-content-center.mb-3
                                        span.fs-3.fw-bold ✓
                                    h1.h3.fw-bold.mb-3 Аккаунт создан
                                    p.text-secondary.mb-4
                                        | #{user.firstName} #{user.lastName}, регистрация прошла успешно.
                                    .alert.alert-success.mb-0(role="alert")
                                        strong Email:
                                        |  #{user.email}
                            else if statusCode
                                .text-center
                                    .brand-mark.bg-danger.bg-opacity-10.text-danger.rounded-circle.d-inline-flex.align-items-center.justify-content-center.mb-3
                                        span.fs-3.fw-bold !
                                    h1.h3.fw-bold.mb-3 Ошибка регистрации
                                    .alert.alert-danger.mb-4(role="alert") #{message}
                                    a.btn.btn-primary.w-100.py-2(href="/registration") Попробовать еще раз
                            else
                                .text-center.mb-4
                                    .brand-mark.bg-primary.bg-opacity-10.text-primary.rounded-circle.d-inline-flex.align-items-center.justify-content-center.mb-3
                                        span.fs-4.fw-bold T
                                    h1.h3.fw-bold.mb-2 Создать аккаунт
                                    p.text-secondary.mb-0 Зарегистрируйтесь, чтобы начать работать с задачами

                                form(method="post", action="/api/auth/registration")
                                    .row.g-3
                                        .col-12.col-md-6
                                            label.form-label(for="firstName") Имя
                                            input#firstName.form-control(
                                                type="text",
                                                name="firstName",
                                                placeholder="Иван",
                                                autocomplete="given-name",
                                                required
                                            )
                                        .col-12.col-md-6
                                            label.form-label(for="lastName") Фамилия
                                            input#lastName.form-control(
                                                type="text",
                                                name="lastName",
                                                placeholder="Иванов",
                                                autocomplete="family-name",
                                                required
                                            )
                                        .col-12
                                            label.form-label(for="email") Email
                                            input#email.form-control(
                                                type="email",
                                                name="email",
                                                placeholder="ivan@example.com",
                                                autocomplete="email",
                                                required
                                            )
                                        .col-12
                                            label.form-label(for="password") Пароль
                                            input#password.form-control(
                                                type="password",
                                                name="password",
                                                placeholder="Минимум 8 символов",
                                                autocomplete="new-password",
                                                required
                                            )
                                        .col-12
                                            button.btn.btn-primary.w-100.py-2(type="submit") Зарегистрироваться
