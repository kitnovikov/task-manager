doctype html
html(lang="ru")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Вход
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css",
            rel="stylesheet"
        )
        style.
            body {
                min-height: 100vh;
                background:
                    radial-gradient(circle at top right, rgba(25, 135, 84, .15), transparent 34rem),
                    linear-gradient(135deg, #f8f9fa 0%, #eef2f7 100%);
            }

            .auth-card {
                border-radius: 1rem;
            }

            .brand-mark {
                width: 3rem;
                height: 3rem;
            }
    body
        main.container
            .row.min-vh-100.align-items-center.justify-content-center.py-5
                .col-12.col-sm-10.col-md-8.col-lg-5
                    .card.auth-card.border-0.shadow-lg
                        .card-body.p-4.p-md-5

                            if statusCode
                                .text-center
                                    .brand-mark.bg-danger.bg-opacity-10.text-danger.rounded-circle.d-inline-flex.align-items-center.justify-content-center.mb-3
                                        span.fs-3.fw-bold !
                                    h1.h3.fw-bold.mb-3 Ошибка входа
                                    .alert.alert-danger.mb-4(role="alert") #{message}
                                    a.btn.btn-primary.w-100.py-2(href="/login") Попробовать еще раз
                            else
                                .text-center.mb-4
                                    .brand-mark.bg-success.bg-opacity-10.text-success.rounded-circle.d-inline-flex.align-items-center.justify-content-center.mb-3
                                        span.fs-4.fw-bold T
                                    h1.h3.fw-bold.mb-2 Войти в аккаунт
                                    p.text-secondary.mb-0 Продолжите работу со своими задачами

                                form#loginForm
                                    .row.g-3
                                        .col-12
                                            label.form-label(for="email") Email
                                            input#email.form-control(
                                                type="email",
                                                name="email",
                                                placeholder="ivan@example.com",
                                                autocomplete="email",
                                                required
                                            )
                                        .col-12
                                            label.form-label(for="password") Пароль
                                            input#password.form-control(
                                                type="password",
                                                name="password",
                                                placeholder="Введите пароль",
                                                autocomplete="current-password",
                                                required
                                            )
                                        .col-12
                                            button.btn.btn-success.w-100.py-2(type="submit") Войти
                                        .col-12
                                            p.text-center.text-secondary.small.mb-0
                                                | Нет аккаунта?
                                                |
                                                a.link-primary.text-decoration-none(href="/registration") Зарегистрироваться
                                    .alert.alert-danger.mt-3.mb-0.d-none#loginError(role="alert")

        script.
            const loginForm = document.getElementById('loginForm')
            const loginError = document.getElementById('loginError')

            if (localStorage.getItem('accessToken')) {
                window.location.replace('/projects')
            }

            const showError = (message) => {
                loginError.classList.remove('d-none')
                loginError.textContent = message
            }

            loginForm?.addEventListener('submit', async (event) => {
                event.preventDefault()

                const formData = new FormData(loginForm)

                try {
                    const response = await fetch('/api/auth/login', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            email: formData.get('email'),
                            password: formData.get('password'),
                        }),
                    })

                    const payload = await response.json()

                    if (!response.ok) {
                        throw new Error(payload.message ?? 'Не удалось войти')
                    }

                    localStorage.setItem('accessToken', payload.accessToken)
                    localStorage.setItem('refreshToken', payload.refreshToken)

                    window.location.assign('/projects')
                } catch (error) {
                    showError(error.message)
                }
            })
