doctype html
html(lang="ru")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Проекты
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css",
            rel="stylesheet"
        )
        style.
            body {
                min-height: 100vh;
                background:
                    radial-gradient(circle at top left, rgba(13, 110, 253, .12), transparent 34rem),
                    linear-gradient(135deg, #f8f9fa 0%, #eef2f7 100%);
            }

            .page-card,
            .project-card {
                border-radius: 1rem;
            }

            .brand-mark {
                width: 2.5rem;
                height: 2.5rem;
            }
    body
        nav.navbar.navbar-expand-lg.bg-white.border-bottom
            .container
                a.navbar-brand.d-flex.align-items-center.gap-2.fw-bold(href="/")
                    span.brand-mark.bg-primary.bg-opacity-10.text-primary.rounded-circle.d-inline-flex.align-items-center.justify-content-center T
                    | Task Manager

                .d-flex.gap-2
                    a.btn.btn-outline-secondary(href="/") Главная
                    button#logoutBtn.btn.btn-outline-danger(type="button") Выйти

        main.container.py-5
            .page-card.bg-white.shadow-sm.border-0.p-4.p-md-5.mb-4
                .d-flex.flex-column.flex-md-row.justify-content-between.gap-3.align-items-md-start
                    div
                        p.text-primary.fw-semibold.mb-2 Проекты
                        h1.h2.fw-bold.mb-2 Список проектов
                        p.text-secondary.mb-0 Просматривайте проекты, где вы являетесь участником.
                    .d-flex.gap-2
                        a.btn.btn-primary(href="/projects/create") Создать проект
                        button#reloadProjectsBtn.btn.btn-outline-primary(type="button") Обновить

                .alert.alert-danger.mt-4.mb-0.d-none#projectsMessage(role="alert")

            #projectsList.row.g-3
            #emptyProjects.card.project-card.border-0.shadow-sm.d-none
                .card-body.p-4.text-center
                    h2.h5.fw-bold.mb-2 Проектов пока нет
                    p.text-secondary.mb-0 Создайте первый проект на отдельной странице.

        script.
            const projectsList = document.getElementById('projectsList')
            const emptyProjects = document.getElementById('emptyProjects')
            const projectsMessage = document.getElementById('projectsMessage')
            const reloadProjectsBtn = document.getElementById('reloadProjectsBtn')
            const logoutBtn = document.getElementById('logoutBtn')

            const getAccessToken = () => localStorage.getItem('accessToken')

            if (!getAccessToken()) {
                window.location.replace('/')
            }

            const formatDate = (value) => {
                if (!value) {
                    return '—'
                }

                return new Intl.DateTimeFormat('ru-RU').format(new Date(value))
            }

            const showError = (message) => {
                projectsMessage.classList.remove('d-none')
                projectsMessage.textContent = message
            }

            const request = async (url, options = {}) => {
                const response = await fetch(url, {
                    ...options,
                    headers: {
                        Authorization: `Bearer ${getAccessToken()}`,
                        ...(options.headers ?? {}),
                    },
                })

                const contentType = response.headers.get('content-type') ?? ''
                const payload = contentType.includes('application/json')
                    ? await response.json()
                    : await response.text()

                if (!response.ok) {
                    if (response.status === 401) {
                        localStorage.removeItem('accessToken')
                        localStorage.removeItem('refreshToken')
                        window.location.replace('/')
                    }

                    throw new Error(payload.message ?? 'Ошибка выполнения запроса')
                }

                return payload
            }

            const renderProjects = (projects) => {
                projectsList.innerHTML = ''
                projectsMessage.classList.add('d-none')
                emptyProjects.classList.toggle('d-none', projects.length > 0)

                for (const project of projects) {
                    const column = document.createElement('div')
                    column.className = 'col-12'
                    column.innerHTML = `
                        <article class="card project-card border-0 shadow-sm">
                            <div class="card-body p-4">
                                <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                                    <div>
                                        <h2 class="h4 fw-bold mb-2">${project.name}</h2>
                                        <p class="text-secondary mb-3">${project.description}</p>
                                        <div class="d-flex flex-wrap gap-3 small text-secondary">
                                            <span><strong class="text-dark">Автор:</strong> ${project.createdBy}</span>
                                            <span><strong class="text-dark">Создан:</strong> ${formatDate(project.createdAt)}</span>
                                        </div>
                                    </div>
                                    <a class="btn btn-outline-primary align-self-start" href="/api/projects/${project.id}">Открыть</a>
                                </div>
                            </div>
                        </article>
                    `
                    projectsList.append(column)
                }
            }

            const loadProjects = async () => {
                try {
                    const projects = await request('/api/projects')
                    renderProjects(projects)
                } catch (error) {
                    renderProjects([])
                    showError(error.message)
                }
            }

            reloadProjectsBtn.addEventListener('click', loadProjects)
            logoutBtn.addEventListener('click', () => {
                localStorage.removeItem('accessToken')
                localStorage.removeItem('refreshToken')
                window.location.replace('/')
            })

            loadProjects()
