doctype html
html(lang="ru")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Task Manager
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css",
            rel="stylesheet"
        )
        style.
            body {
                min-height: 100vh;
                background:
                    radial-gradient(circle at top left, rgba(13, 110, 253, .14), transparent 34rem),
                    radial-gradient(circle at bottom right, rgba(25, 135, 84, .12), transparent 30rem),
                    linear-gradient(135deg, #f8f9fa 0%, #eef2f7 100%);
            }

            .navbar {
                backdrop-filter: blur(16px);
            }

            .hero-card,
            .project-card {
                border-radius: 1rem;
            }

            .brand-mark {
                width: 2.5rem;
                height: 2.5rem;
            }
    body
        nav.navbar.navbar-expand-lg.bg-white.bg-opacity-75.border-bottom.sticky-top
            .container
                a.navbar-brand.d-flex.align-items-center.gap-2.fw-bold(href="/")
                    span.brand-mark.bg-primary.bg-opacity-10.text-primary.rounded-circle.d-inline-flex.align-items-center.justify-content-center T
                    | Task Manager

                button.navbar-toggler(
                    type="button",
                    data-bs-toggle="collapse",
                    data-bs-target="#mainNavbar",
                    aria-controls="mainNavbar",
                    aria-expanded="false",
                    aria-label="Открыть меню"
                )
                    span.navbar-toggler-icon

                #mainNavbar.collapse.navbar-collapse
                    ul.navbar-nav.me-auto.mb-2.mb-lg-0.ms-lg-4
                        li.nav-item
                            a.nav-link.active(href="/", aria-current="page") Главная
                        li.nav-item
                            a.nav-link.auth-required(href="/projects") Проекты

                    .d-flex.gap-2
                        a.btn.btn-outline-primary(href="/registration") Регистрация
                        a.btn.btn-primary(href="/login") Войти

        main
            section.container.py-5.py-lg-6
                .row.align-items-center.g-4.g-lg-5
                    .col-12.col-lg-6
                        p.text-primary.fw-semibold.mb-2 Управление задачами
                        h1.display-5.fw-bold.mb-3 Планируйте проекты и держите задачи под контролем
                        p.lead.text-secondary.mb-4
                            | Создавайте проекты, собирайте задачи в одном месте и быстрее переходите от идеи к выполнению.
                        .d-flex.flex-column.flex-sm-row.gap-2
                            a.btn.btn-primary.btn-lg.auth-required(href="/projects") Начать
                            a.btn.btn-outline-secondary.btn-lg(href="/login") У меня уже есть аккаунт

                    .col-12.col-lg-6
                        .card.hero-card.border-0.shadow-lg
                            .card-body.p-4.p-md-5
                                .d-flex.justify-content-between.align-items-start.mb-4
                                    div
                                        h2.h5.fw-bold.mb-1 Рабочая неделя
                                        p.text-secondary.mb-0 3 проекта в работе
                                    span.badge.text-bg-success В фокусе

                                .list-group.list-group-flush
                                    .list-group-item.px-0.d-flex.justify-content-between.align-items-center
                                        span Запустить личный кабинет
                                        span.badge.text-bg-primary 75%
                                    .list-group-item.px-0.d-flex.justify-content-between.align-items-center
                                        span Подготовить API задач
                                        span.badge.text-bg-warning 40%
                                    .list-group-item.px-0.d-flex.justify-content-between.align-items-center
                                        span Проверить email-уведомления
                                        span.badge.text-bg-secondary 20%

            section#projects.container.pb-5
                .d-flex.justify-content-between.align-items-end.mb-3
                    div
                        h2.h3.fw-bold.mb-1 Проекты
                        p.text-secondary.mb-0 Основные направления работы в таск-трекере.

                .row.g-3
                    .col-12.col-md-4
                        .card.project-card.h-100.border-0.shadow-sm
                            .card-body
                                h3.h5.fw-bold Личные задачи
                                p.text-secondary.mb-0 Быстрый список дел на день и неделю.
                    .col-12.col-md-4
                        .card.project-card.h-100.border-0.shadow-sm
                            .card-body
                                h3.h5.fw-bold Командные проекты
                                p.text-secondary.mb-0 Общее пространство для задач команды.
                    .col-12.col-md-4
                        .card.project-card.h-100.border-0.shadow-sm
                            .card-body
                                h3.h5.fw-bold Запуски продукта
                                p.text-secondary.mb-0 Контроль этапов, приоритетов и прогресса.

        script(
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        )
        script.
            document.querySelectorAll('.auth-required').forEach((link) => {
                link.addEventListener('click', (event) => {
                    if (!localStorage.getItem('accessToken')) {
                        event.preventDefault()
                        window.location.assign('/')
                    }
                })
            })
